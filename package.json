{
  "name": "pomodoro-timer",
  "version": "1.1.0",
  "private": true,
  "description": "A configurable pomodoro-like timer",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8888",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint 'src/**/*.*' && oxfmt --check --no-error-on-unmatched-pattern",
    "serve": "vite preview",
    "dev:test": "vite dev --port 8888 --mode=test",
    "test": "playwright test"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": "^10.29.3"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "pinia": "4.1.0",
    "uid": "2.0.2",
    "vue": "3.5.44",
    "vue-types": "7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/zondicons": "1.2.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.15",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-sfc": "3.5.44",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "lefthook": "2.2.2",
    "oxfmt": "^0.75.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vite-svg-loader": "5.1.3",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.2.6",
    "workbox-window": "7.4.1"
  }
}
